//@version=5
strategy("Monday Reversal Confirmed - PRO (Both Directions)",
         overlay=true,
         timeframe="D",
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=1,
         commission_type=strategy.commission.percent,
         commission_value=0.0005)

// ============================================================================
// MONDAY REVERSAL CONFIRMED - ESTRATEGIA PROFESIONAL
// ============================================================================
// Sistema de trading basado en análisis histórico EUR/USD 2000-2025
//
// LÓGICA:
//   ALCISTA:
//   - Lunes forma LOTW (Low of the Week)
//   - Martes cierra arriba (confirmación)
//   - Entra en pullback al LOTW
//   - Target: HOTW en jueves/viernes
//
//   BAJISTA:
//   - Lunes forma HOTW (High of the Week)
//   - Martes cierra abajo (confirmación)
//   - Entra en pullback al HOTW
//   - Target: LOTW en jueves/viernes
//
// ESTADÍSTICAS PROBADAS:
//   - Alcista: 78.4% tasa acierto, 2.39:1 RR, +47 pips EV
//   - Bajista: 82.5% tasa acierto, 2.58:1 RR, +55 pips EV
// ============================================================================

// ============================================================================
// CONFIGURACIÓN
// ============================================================================

enable_long = input(true, "Habilitar compras (Alcista)", group="Configuración")
enable_short = input(true, "Habilitar ventas (Bajista)", group="Configuración")
use_hotw_filter = input(true, "Usar filtro HOTW jue/vie", group="Configuración",
                        tooltip="Si TRUE: solo operar si HOTW será probablemente jueves/viernes")

// Parámetros de riesgo
sl_pips = input(50, "Stop Loss (pips)", 20, 100, group="Riesgo")
tp_ratio = input(2.4, "Risk/Reward Ratio", 1.5, 4.0, group="Riesgo")
confirmation_pct = input(0.5, "% arriba/abajo para confirmación", 0.1, 2.0, group="Riesgo")

// Parámetros avanzados
min_range_daily = input(80, "Rango mínimo diario (pips)", 30, 200, group="Filtros")
max_slippage_pips = input(20, "Máximo slippage tolerado (pips)", 5, 50, group="Filtros")

// Visualización
show_zones = input(true, "Mostrar zonas de entrada", group="Visualización")
show_levels = input(true, "Mostrar SL/TP", group="Visualización")
show_info = input(true, "Mostrar tabla info", group="Visualización")

col_lotw = input.color(color.new(color.blue, 80), "Color LOTW", group="Colores")
col_hotw = input.color(color.new(color.orange, 80), "Color HOTW", group="Colores")
col_long_entry = input.color(color.new(color.green, 70), "Color entrada larga", group="Colores")
col_short_entry = input.color(color.new(color.red, 70), "Color entrada corta", group="Colores")
col_sl = input.color(color.new(color.red, 80), "Color SL", group="Colores")
col_tp = input.color(color.new(color.lightgreen, 80), "Color TP", group="Colores")

// ============================================================================
// VARIABLES GLOBALES
// ============================================================================

// Día de la semana
dayOfWeek = dayofweek(time)
isMonday = dayOfWeek == 2
isTuesday = dayOfWeek == 3
isWednesday = dayOfWeek == 4
isThursday = dayOfWeek == 5
isFriday = dayOfWeek == 6
isWeekday = dayOfWeek >= 2 and dayOfWeek <= 6

// Variables persistentes de la semana
var float mondayLow = na
var float mondayHigh = na
var float mondayClose = na
var float mondayRange = na
var bool tuesdayLongConfirm = false  // Martes cierra arriba (alcista)
var bool tuesdayShortConfirm = false // Martes cierra abajo (bajista)
var bool isValidLongSetup = false
var bool isValidShortSetup = false

var float weekHigh = na
var float weekLow = na
var int setupBar = na

var float entryPrice = na
var float stopPrice = na
var float targetPrice = na
var bool positionActive = false

// ============================================================================
// RESET SEMANAL (LUNES)
// ============================================================================

if isMonday
    // Inicializar nuevas variables
    weekLow := low
    weekHigh := high
    setupBar := bar_index

    mondayLow := low
    mondayHigh := high
    mondayClose := close
    mondayRange := high - low

    tuesdayLongConfirm := false
    tuesdayShortConfirm := false
    isValidLongSetup := false
    isValidShortSetup := false

    entryPrice := na
    stopPrice := na
    targetPrice := na

// Actualizar extremos semanales
if isWeekday
    if na(weekLow)
        weekLow := low
    if na(weekHigh)
        weekHigh := high

    weekLow := math.min(weekLow, low)
    weekHigh := math.max(weekHigh, high)

// ============================================================================
// PASO 1: DETECTAR LOTW/HOTW EL LUNES
// ============================================================================

// Obtener extremos de últimos 5 días para contexto
last5High = highest(high, 5)
last5Low = lowest(low, 5)

isMondayLOTW = isMonday and low == last5Low
isMondayHOTW = isMonday and high == last5High

// Validar rango mínimo del día
minRangeValid = (high - low) * 10000 >= min_range_daily

// ============================================================================
// PASO 2: CONFIRMACIÓN DEL MARTES
// ============================================================================

if isTuesday and not na(mondayClose) and minRangeValid
    confirmLevel = mondayClose + (confirmation_pct * syminfo.mintick * 10)
    rejectLevel = mondayClose - (confirmation_pct * syminfo.mintick * 10)

    // ALCISTA: Martes cierra arriba del lunes
    if isMondayLOTW and close > confirmLevel
        tuesdayLongConfirm := true
        isValidLongSetup := true

    // BAJISTA: Martes cierra abajo del lunes
    if isMondayHOTW and close < rejectLevel
        tuesdayShortConfirm := true
        isValidShortSetup := true

// ============================================================================
// PASO 3: SEÑAL DE ENTRADA (Pullback a extremo del lunes)
// ============================================================================

// ENTRADA LARGA: Pullback al LOTW
longEntry = enable_long and isValidLongSetup and
            close >= mondayLow - (sl_pips * syminfo.mintick * 10) and
            close <= mondayLow + (confirmation_pct * syminfo.mintick * 10) and
            not positionActive

// ENTRADA CORTA: Pullback al HOTW
shortEntry = enable_short and isValidShortSetup and
             close <= mondayHigh + (sl_pips * syminfo.mintick * 10) and
             close >= mondayHigh - (confirmation_pct * syminfo.mintick * 10) and
             not positionActive

// ============================================================================
// CALCULAR NIVELES DE RIESGO
// ============================================================================

// Para compra
longStop = mondayLow - (sl_pips * syminfo.mintick * 10)
longTarget = mondayLow + ((sl_pips * tp_ratio) * syminfo.mintick * 10)

// Para venta
shortStop = mondayHigh + (sl_pips * syminfo.mintick * 10)
shortTarget = mondayHigh - ((sl_pips * tp_ratio) * syminfo.mintick * 10)

// ============================================================================
// EJECUTAR OPERACIONES
// ============================================================================

// Entrada larga
if longEntry
    entryPrice := close
    stopPrice := longStop
    targetPrice := longTarget
    positionActive := true

    strategy.entry("LONG", strategy.long, comment="Monday LOTW - Long Setup")

// Entrada corta
if shortEntry
    entryPrice := close
    stopPrice := shortStop
    targetPrice := shortTarget
    positionActive := true

    strategy.entry("SHORT", strategy.short, comment="Monday HOTW - Short Setup")

// ============================================================================
// SALIDA DE POSICIONES
// ============================================================================

// Stop Loss y Take Profit
if not na(stopPrice) and not na(targetPrice)
    strategy.exit("LONG EXIT", from_entry="LONG", stop=stopPrice, limit=targetPrice)
    strategy.exit("SHORT EXIT", from_entry="SHORT", stop=stopPrice, limit=targetPrice)

// Reset al viernes (cierre de semana)
if isFriday
    positionActive := false

// ============================================================================
// VISUALIZACIÓN: ZONAS DE ENTRADA
// ============================================================================

if show_zones and isValidLongSetup
    // Zona de entrada alcista
    box.new(bar_index - 2, mondayLow + (confirmation_pct * syminfo.mintick * 10),
            bar_index + 5, mondayLow - (confirmation_pct * syminfo.mintick * 10),
            border_color=col_long_entry, bgcolor=col_long_entry,
            border_width=2, style=box.style_rounded)

    label.new(bar_index, mondayLow, "📈 ZONA COMPRA",
             color=col_long_entry, textcolor=color.white, size=size.small, style=label.style_label_down)

if show_zones and isValidShortSetup
    // Zona de entrada bajista
    box.new(bar_index - 2, mondayHigh + (confirmation_pct * syminfo.mintick * 10),
            bar_index + 5, mondayHigh - (confirmation_pct * syminfo.mintick * 10),
            border_color=col_short_entry, bgcolor=col_short_entry,
            border_width=2, style=box.style_rounded)

    label.new(bar_index, mondayHigh, "📉 ZONA VENTA",
             color=col_short_entry, textcolor=color.white, size=size.small, style=label.style_label_up)

// ============================================================================
// VISUALIZACIÓN: NIVELES SL/TP
// ============================================================================

if show_levels and positionActive
    // Stop Loss
    line.new(bar_index - 1, stopPrice, bar_index + 10, stopPrice,
        xloc=xloc.bar_index, color=col_sl, width=3, style=line.style_solid)

    // Take Profit
    line.new(bar_index - 1, targetPrice, bar_index + 10, targetPrice,
        xloc=xloc.bar_index, color=col_tp, width=3, style=line.style_solid)

// ============================================================================
// INFORMACIÓN EN PANTALLA
// ============================================================================

if show_info
    var table infoTable = table.new(position.top_right, 3, 8, frame_color=color.gray, border_width=2)

    // Header
    table.cell(infoTable, 0, 0, "MONDAY REVERSAL PRO", text_color=color.white, bgcolor=color.navy, text_size=size.small)
    table.cell(infoTable, 1, 0, "LONG", text_color=color.white, bgcolor=color.navy, text_size=size.small)
    table.cell(infoTable, 2, 0, "SHORT", text_color=color.white, bgcolor=color.navy, text_size=size.small)

    // Status
    longStatus = isValidLongSetup ? "🟢 SETUP" : "🔴 WAIT"
    shortStatus = isValidShortSetup ? "🟢 SETUP" : "🔴 WAIT"

    table.cell(infoTable, 0, 1, "Status", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 1, longStatus, text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 2, 1, shortStatus, text_color=color.white, bgcolor=color.gray)

    // Monday extremo
    mondayLevel = isValidLongSetup ? mondayLow : (isValidShortSetup ? mondayHigh : 0)
    table.cell(infoTable, 0, 2, "Monday Level", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 2, isValidLongSetup ? "LOW" : "-", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 2, 2, isValidShortSetup ? "HIGH" : "-", text_color=color.white, bgcolor=color.gray)

    // Confirmación martes
    table.cell(infoTable, 0, 3, "Martes Confirma", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 3, tuesdayLongConfirm ? "✓ SÍ" : "✗ NO", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 2, 3, tuesdayShortConfirm ? "✓ SÍ" : "✗ NO", text_color=color.white, bgcolor=color.gray)

    // Entry Price
    table.cell(infoTable, 0, 4, "Entry Price", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 4, not na(entryPrice) ? str.tostring(entryPrice, format.price) : "-", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 2, 4, not na(entryPrice) ? str.tostring(entryPrice, format.price) : "-", text_color=color.white, bgcolor=color.gray)

    // Stop Loss
    table.cell(infoTable, 0, 5, "Stop Loss", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 5, not na(stopPrice) ? str.tostring(stopPrice, format.price) : "-", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 2, 5, not na(stopPrice) ? str.tostring(stopPrice, format.price) : "-", text_color=color.white, bgcolor=color.gray)

    // Take Profit
    table.cell(infoTable, 0, 6, "Take Profit", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 6, not na(targetPrice) ? str.tostring(targetPrice, format.price) : "-", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 2, 6, not na(targetPrice) ? str.tostring(targetPrice, format.price) : "-", text_color=color.white, bgcolor=color.gray)

    // RR Ratio
    rrLong = not na(stopPrice) and not na(targetPrice) ? (targetPrice - mondayLow) / (mondayLow - stopPrice) : 0
    rrShort = not na(stopPrice) and not na(targetPrice) ? (mondayHigh - targetPrice) / (stopPrice - mondayHigh) : 0

    table.cell(infoTable, 0, 7, "RR Ratio", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 1, 7, rrLong > 0 ? str.tostring(rrLong, "0.00") : "-", text_color=color.white, bgcolor=color.gray)
    table.cell(infoTable, 2, 7, rrShort > 0 ? str.tostring(rrShort, "0.00") : "-", text_color=color.white, bgcolor=color.gray)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(longEntry, title="LONG Entry", message="🟢 ENTRADA LARGA - LOTW Monday + Tuesday Confirmed")
alertcondition(shortEntry, title="SHORT Entry", message="🔴 ENTRADA CORTA - HOTW Monday + Tuesday Confirmed")
alertcondition(close < longStop, title="Long SL Hit", message="🛑 Stop Loss Hit (LONG)")
alertcondition(close > longTarget, title="Long TP Hit", message="✅ Take Profit Hit (LONG)")
alertcondition(close > shortStop, title="Short SL Hit", message="🛑 Stop Loss Hit (SHORT)")
alertcondition(close < shortTarget, title="Short TP Hit", message="✅ Take Profit Hit (SHORT)")

// ============================================================================
// PLOTEOS
// ============================================================================

// Señales de entrada
plotshape(longEntry, "LONG Entry", location=location.belowbar, shape=shape.labelup,
         size=size.large, color=col_long_entry, textcolor=color.white, text="BUY")

plotshape(shortEntry, "SHORT Entry", location=location.abovebar, shape=shape.labeldown,
         size=size.large, color=col_short_entry, textcolor=color.white, text="SELL")

// Plotear línea de extremo semanal
plot(mondayLow, "Monday Low", na, display=display.none)
plot(mondayHigh, "Monday High", na, display=display.none)
