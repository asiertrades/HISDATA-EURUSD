// BREAKER M15 TRAS SEÑAL CISD H4
// ─────────────────────────────────────────────────────────────────────────────
// Se pone en un gráfico de M15. Corre el motor CISD sobre las velas H4 cerradas
// (sin repintado) y, cuando hay señal, marca la zona breaker de M15 con su nivel
// de entrada y su stop, para poder contrastarlo a ojo con las entradas marcadas
// a mano.
//
// Zona   = vela que precede a un desplazamiento; su rango completo, mechas incluidas.
// Polaridad: OB alcista (vela bajista en la base de una subida) = soporte;
//            OB bajista (vela alcista antes de una caída) = resistencia.
//            Si el precio cierra al otro lado, la zona VOLTEA: eso es el breaker.
// Entrada = primer toque del rango de la zona breaker más cercana en el sentido
//           del trade (el borde de la vela, no su cuerpo).
// Stop    = más allá del extremo de la siguiente zona de la cadena; si no cabe en
//           el tope de riesgo, apretado a su open.
// ─────────────────────────────────────────────────────────────────────────────
//@version=5
indicator("Breaker M15 tras CISD H4", overlay=true, max_boxes_count=200, max_lines_count=250, max_labels_count=200)

// ══════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════
gH4 = "Señal CISD en H4"
i_obMinBody    = input.float(0.40, "OB Min Body Ratio (tier A)",  step=0.05, group=gH4)
i_cisdMinBody  = input.float(0.55, "CISD Min Body Ratio (Clean)", step=0.05, group=gH4)
i_perDir       = input.bool(true,  "Rearme por dirección",                   group=gH4)
i_doubtPersist = input.bool(true,  "Dudoso persistente",                     group=gH4)
i_hour9        = input.bool(false, "CISD también a las 9:00",                group=gH4)
i_tierB        = input.bool(true,  "Tier B (regla universal)",               group=gH4)
i_bMinBody     = input.float(1.0,  "Tier B: cuerpo mínimo del OB (pips)", step=0.5, group=gH4)
i_noBFri       = input.bool(true,  "Tier B: apagar los viernes",             group=gH4)
i_noB21        = input.bool(true,  "Tier B: sin señal en la vela de 21:00",  group=gH4)
i_bWick        = input.bool(true,  "Tier B: mecha < cuerpo",                 group=gH4)

gBK = "Breaker en M15"
i_soloTras   = input.bool(true,  "Mostrar solo tras una señal H4",           group=gBK)
i_ventanaH   = input.int (12,    "Horas de validez tras la señal",  minval=1, group=gBK)
i_cuerpoR    = input.float(0.8,  "Cuerpo mínimo de la zona (x mediana 20)", step=0.1, group=gBK)
i_frescuraH  = input.int (24,    "Antigüedad máxima de la zona (horas)", minval=1, group=gBK)
i_maxDistP   = input.float(25.0, "Distancia máxima al precio (pips)", step=1, group=gBK)
i_topeRiesgo = input.float(12.0, "Riesgo máximo admitido (pips)",     step=0.5, group=gBK)
i_colchonP   = input.float(1.0,  "Colchón del stop (pips)",           step=0.5, group=gBK)
i_verTodas   = input.bool(false, "Dibujar también las zonas no elegidas",    group=gBK)

gCol = "Colores"
c_bull   = input.color(color.new(#2962ff, 80), "Zona alcista",  group=gCol)
c_bear   = input.color(color.new(#ff5252, 80), "Zona bajista",  group=gCol)
c_entrada= input.color(color.new(#000000, 0),  "Línea de entrada", group=gCol)
c_stop   = input.color(color.new(#ff5252, 0),  "Línea de stop",    group=gCol)
c_otras  = input.color(color.new(#9e9e9e, 92), "Zonas no elegidas",group=gCol)

float PIP = syminfo.mintick * 10

// ══════════════════════════════════════════════════════════════════
// MOTOR CISD SOBRE VELAS H4 CERRADAS (sin repintado)
// ══════════════════════════════════════════════════════════════════
[h4o, h4h, h4l, h4c] = request.security(syminfo.tickerid, "240", [open[1], high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)
h4t = request.security(syminfo.tickerid, "240", time[1], lookahead=barmerge.lookahead_off)

bool nuevaH4 = ta.change(h4t) != 0

var float refH = na
var float refL = na
var float lBullO = na
var float lBullL = na
var float lBearO = na
var float lBearH = na
var float aBullO = na
var float aBearO = na
var bool  sweptH = false
var bool  sweptL = false
var bool  fABear = false
var bool  fABull = false
var bool  fBBear = false
var bool  fBBull = false
var bool  doubtBear = false
var bool  doubtBull = false

var bool  senalBear = false
var bool  senalBull = false
var int   senalT    = na

if nuevaH4 and not na(h4c)
    senalBear := false
    senalBull := false

    int   hNY   = hour(int(h4t), "America/New_York")
    bool  is17  = hNY == 17
    float rng   = math.max(h4h - h4l, syminfo.mintick)
    float body  = math.abs(h4c - h4o)
    float bodyR = body / rng
    bool  isBull = h4c > h4o
    bool  isBear = h4c < h4o
    float upW = isBull ? h4h - h4c : h4h - h4o
    float dnW = isBull ? h4o - h4l : h4c - h4l

    if is17
        refH := h4h
        refL := h4l
        sweptH := false
        sweptL := false
        fABear := false
        fABull := false
        fBBear := false
        fBBull := false
        doubtBear := false
        doubtBull := false
        lBullO := na
        lBullL := na
        lBearO := na
        lBearH := na
        aBullO := na
        aBearO := na

    bool doneA = i_perDir ? (fABear and fABull) : (fABear or fABull)

    if not na(refH) and bodyR >= i_obMinBody
        if isBull
            lBullO := h4o
            lBullL := h4l
        if isBear
            lBearO := h4o
            lBearH := h4h

    if not na(refH) and not doneA
        if not sweptH and h4h > refH
            sweptH := true
        if not sweptL and h4l < refL
            sweptL := true

    bool valida = hNY == 21 or hNY == 1 or hNY == 5 or (i_hour9 and hNY == 9)
    bool fABearBar = false
    bool fABullBar = false

    // dudosos
    if not doneA and valida
        if doubtBear and not fABear
            if isBear and bodyR >= i_cisdMinBody and dnW < body
                senalBear := true
                fABear := true
                fABearBar := true
                doubtBear := false
            else if i_doubtPersist
                if isBull
                    doubtBear := false
            else
                doubtBear := false
        if doubtBull and not fABull
            if isBull and bodyR >= i_cisdMinBody and upW < body
                senalBull := true
                fABull := true
                fABullBar := true
                doubtBull := false
            else if i_doubtPersist
                if isBear
                    doubtBull := false
            else
                doubtBull := false

    doneA := i_perDir ? (fABear and fABull) : (fABear or fABull)

    // tier A
    if not doneA and valida
        if sweptH and not na(lBullO) and not fABear and isBear and h4c < lBullO
            float rBear = body / math.max(body + dnW, syminfo.mintick)
            if rBear >= i_cisdMinBody and dnW < body and h4c < lBullL
                senalBear := true
                fABear := true
                fABearBar := true
            else if not doubtBear
                doubtBear := true
        bool doneA2 = i_perDir ? (fABear and fABull) : (fABear or fABull)
        if not doneA2 and sweptL and not na(lBearO) and not fABull and isBull and h4c > lBearO
            float rBull = body / math.max(body + upW, syminfo.mintick)
            if rBull >= i_cisdMinBody and upW < body and h4c > lBearH
                senalBull := true
                fABull := true
                fABullBar := true
            else if not doubtBull
                doubtBull := true

    // tier B
    bool esVie = dayofweek(int(h4t) + 4 * 60 * 60 * 1000, "America/New_York") == dayofweek.friday
    if i_tierB and valida and (sweptH or sweptL) and not (i_noBFri and esVie) and not (i_noB21 and hNY == 21)
        bool wOKb = not i_bWick or dnW < body
        bool wOKl = not i_bWick or upW < body
        if not fABear and not fBBear and not fABearBar and not na(aBullO) and isBear and h4c < aBullO and wOKb
            senalBear := true
            fBBear := true
        if not fABull and not fBBull and not fABullBar and not na(aBearO) and isBull and h4c > aBearO and wOKl
            senalBull := true
            fBBull := true

    // OB de tier B: se actualiza al final
    if not na(refH) and body >= i_bMinBody * PIP
        if isBull
            aBullO := h4o
        if isBear
            aBearO := h4o

    if senalBear or senalBull
        senalT := time

// ══════════════════════════════════════════════════════════════════
// ZONAS (ORDER BLOCKS) EN M15 Y SU POLARIDAD
// ══════════════════════════════════════════════════════════════════
type Zona
    float o
    float h
    float l
    bool  velaAlcista
    int   pol            // 1 = soporte, -1 = resistencia
    int   t
    int   bar

var Zona[] zonas   = array.new<Zona>()
var Zona   candAlc = na
var Zona   candBaj = na

float cuerpo = math.abs(close - open)

// mediana de los últimos 20 cuerpos, calculada a mano para no depender de
// built-ins que cambian entre versiones
var float[] cuerposRec = array.new_float()
float medCuerpo = na
if barstate.isconfirmed
    cuerposRec.push(cuerpo)
    if cuerposRec.size() > 20
        cuerposRec.shift()
if cuerposRec.size() >= 5
    float[] orden = array.copy(cuerposRec)
    array.sort(orden)
    medCuerpo := array.get(orden, orden.size() / 2)
bool significativa = na(medCuerpo) or medCuerpo <= 0 ? true : cuerpo >= i_cuerpoR * medCuerpo

if barstate.isconfirmed
    // activación: la vela cierra a través del open del OB contrario
    if close > open and not na(candBaj)
        if close > candBaj.o
            candBaj.pol := 1
            zonas.push(candBaj)
            candBaj := na
    if close < open and not na(candAlc)
        if close < candAlc.o
            candAlc.pol := -1
            zonas.push(candAlc)
            candAlc := na

    // volteo de polaridad
    if zonas.size() > 0
        for i = 0 to zonas.size() - 1
            Zona z = zonas.get(i)
            if z.pol == 1 and close < z.l
                z.pol := -1
            else if z.pol == -1 and close > z.h
                z.pol := 1

    // la vela actual pasa a ser candidata
    if significativa
        Zona nueva = Zona.new(open, high, low, close > open, 0, time, bar_index)
        if close > open
            candAlc := nueva
        else if close < open
            candBaj := nueva

    // limpieza por antigüedad
    // ojo: `and` no hace cortocircuito en Pine, asi que la comprobacion de
    // tamaño y el acceso al elemento no pueden ir en la misma condicion
    bool purgar = true
    while purgar
        purgar := false
        if zonas.size() > 0
            if (time - zonas.get(0).t) > i_frescuraH * 60 * 60 * 1000
                zonas.shift()
                purgar := true
    while zonas.size() > 40
        zonas.shift()

// ══════════════════════════════════════════════════════════════════
// AL LLEGAR UNA SEÑAL: ELEGIR BREAKER, ENTRADA Y STOP
// ══════════════════════════════════════════════════════════════════
var box   bxBreaker = na
var box   bxOrigen  = na
var line  lnEntrada = na
var line  lnStop    = na
var label lbPlan    = na
var float nivelEntrada = na
var float nivelStop    = na
var bool  planLargo    = false
var bool  planVivo     = false
var int   planT        = na

if barstate.isconfirmed and (senalBear or senalBull) and zonas.size() > 0
    bool largo = senalBull
    // candidatas: polaridad correcta, al otro lado del precio y no muy lejos
    int   mejor = -1
    float mejorNivel = na
    for i = 0 to zonas.size() - 1
        Zona z = zonas.get(i)
        bool ok = false
        if largo
            ok := z.pol == 1 and z.h <= close and (close - z.h) <= i_maxDistP * PIP
        else
            ok := z.pol == -1 and z.l >= close and (z.l - close) <= i_maxDistP * PIP
        if ok
            float niv = largo ? z.h : z.l
            if mejor == -1 or (largo ? niv > mejorNivel : niv < mejorNivel)
                mejor := i
                mejorNivel := niv

    if mejor != -1
        Zona brk = zonas.get(mejor)
        float entrada = largo ? brk.h : brk.l

        // siguiente zona de la cadena: la que originó el impulso
        int   sig = -1
        float sigNivel = na
        for i = 0 to zonas.size() - 1
            Zona z = zonas.get(i)
            bool detras = largo ? z.h < brk.l : z.l > brk.h
            if detras
                float niv = largo ? z.h : z.l
                if sig == -1 or (largo ? niv > sigNivel : niv < sigNivel)
                    sig := i
                    sigNivel := niv

        float sl = na
        if sig != -1
            Zona zs = zonas.get(sig)
            float slExtremo = largo ? zs.l - i_colchonP * PIP : zs.h + i_colchonP * PIP
            float slOpen    = zs.o
            if math.abs(entrada - slExtremo) <= i_topeRiesgo * PIP
                sl := slExtremo
            else if math.abs(entrada - slOpen) <= i_topeRiesgo * PIP and (largo ? slOpen < entrada : slOpen > entrada)
                sl := slOpen
        if na(sl)
            float slPropio = largo ? brk.l - i_colchonP * PIP : brk.h + i_colchonP * PIP
            if math.abs(entrada - slPropio) <= i_topeRiesgo * PIP
                sl := slPropio

        if not na(sl)
            if not na(bxBreaker)
                box.delete(bxBreaker)
            if not na(bxOrigen)
                box.delete(bxOrigen)
            if not na(lnEntrada)
                line.delete(lnEntrada)
            if not na(lnStop)
                line.delete(lnStop)
            if not na(lbPlan)
                label.delete(lbPlan)

            int derecha = bar_index + i_ventanaH * 4
            bxBreaker := box.new(brk.bar, brk.h, derecha, brk.l,
                                 bgcolor = largo ? c_bull : c_bear,
                                 border_color = color.new(largo ? c_bull : c_bear, 0), border_width = 1)
            if sig != -1
                Zona zs = zonas.get(sig)
                bxOrigen := box.new(zs.bar, zs.h, derecha, zs.l, bgcolor=c_otras,
                                     border_color=color.new(#9e9e9e, 40), border_width=1)
            lnEntrada := line.new(brk.bar, entrada, derecha, entrada, color=c_entrada, width=2)
            lnStop    := line.new(brk.bar, sl, derecha, sl, color=c_stop, width=1, style=line.style_dashed)
            float riesgo = math.abs(entrada - sl) / PIP
            lbPlan := label.new(derecha, entrada,
                                 (largo ? "LARGO" : "CORTO") + "  entrada " + str.tostring(entrada, format.mintick) +
                                 "\nstop " + str.tostring(sl, format.mintick) + "   riesgo " + str.tostring(riesgo, "#.#") + "p",
                                 style = label.style_label_left,
                                 color = color.new(color.white, 100),
                                 textcolor = chart.fg_color, size = size.small,
                                 text_font_family = font.family_monospace)
            nivelEntrada := entrada
            nivelStop    := sl
            planLargo    := largo
            planVivo     := true
            planT        := time

// caducidad del plan
if planVivo and not na(planT) and (time - planT) > i_ventanaH * 60 * 60 * 1000
    planVivo := false

// ══════════════════════════════════════════════════════════════════
// ZONAS SUELTAS (opcional) Y MARCAS
// ══════════════════════════════════════════════════════════════════
if i_verTodas and not i_soloTras and barstate.islast and zonas.size() > 0
    for i = 0 to zonas.size() - 1
        Zona z = zonas.get(i)
        box.new(z.bar, z.h, bar_index + 2, z.l, bgcolor=c_otras,
                 border_color=color.new(#9e9e9e, 60), border_width=1)

// la señal vive todo el periodo H4: se marca solo en la vela M15 del cierre
bool marcaBear = senalBear and nuevaH4
bool marcaBull = senalBull and nuevaH4
plotshape(marcaBear, title="Señal CISD bajista", style=shape.triangledown,
          location=location.abovebar, color=color.new(#ff5252, 0), size=size.small)
plotshape(marcaBull, title="Señal CISD alcista", style=shape.triangleup,
          location=location.belowbar, color=color.new(#26a69a, 0), size=size.small)

// toque del nivel de entrada
bool tocado = planVivo and not na(nivelEntrada) and (planLargo ? low <= nivelEntrada : high >= nivelEntrada)
plotshape(tocado and planLargo,      title="Toque de la entrada (largo)", style=shape.circle,
          location=location.belowbar, color=color.new(#000000, 0), size=size.tiny)
plotshape(tocado and not planLargo,  title="Toque de la entrada (corto)", style=shape.circle,
          location=location.abovebar, color=color.new(#000000, 0), size=size.tiny)

alertcondition(marcaBear or marcaBull, "Señal CISD H4", "Señal CISD en H4 — breaker marcado en M15")
alertcondition(tocado, "Toque del breaker", "El precio ha tocado el nivel de entrada del breaker")
