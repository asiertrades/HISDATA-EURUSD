//@version=5
indicator("Monday Reversal Confirmed - Trading System", overlay=true, timeframe="D")

// ============================================================================
// MONDAY REVERSAL CONFIRMED STRATEGY
// ============================================================================
// Entrada en daily basado en análisis histórico EUR/USD 2000-2025
// - Detecta LOTW (Low of the Week) el lunes
// - Confirma reversal el martes (cierre arriba)
// - Espera HOTW en jueves/viernes (con filtro de expansión)
// - Marca entrada, SL, TP en el gráfico
//
// Parámetros probados:
// - Tasa acierto: 78.4% - 82.5%
// - RR Ratio: 2.39:1 - 2.58:1
// - Expected Value: +47 a +55 pips
// ============================================================================

// ============================================================================
// CONFIGURACIÓN
// ============================================================================

// Parámetros de entrada
var_confirm_pct = input.float(0.5, "% confirmar martes (0.5 = 0.5% arriba lunes)", 0.1, 2.0)
var_sl_pips = input.int(50, "Stop Loss (pips)", 20, 100)
var_risk_reward = input.float(2.4, "Risk/Reward Target", 1.5, 4.0)

// Colores
col_setup = input.color(color.new(color.blue, 80), "Color Setup")
col_entry = input.color(color.new(color.green, 80), "Color Entry")
col_sl = input.color(color.new(color.red, 80), "Color SL")
col_tp = input.color(color.new(color.orange, 80), "Color TP")

// ============================================================================
// DETECTAR DÍA DE LA SEMANA
// ============================================================================

dayOfWeek = dayofweek(time)
// 1=Sunday, 2=Monday, 3=Tuesday, 4=Wednesday, 5=Thursday, 6=Friday, 7=Saturday

isMonday = dayOfWeek == 2
isTuesday = dayOfWeek == 3
isWednesday = dayOfWeek == 4
isThursday = dayOfWeek == 5
isFriday = dayOfWeek == 6

isWeekday = isMonday or isTuesday or isWednesday or isThursday or isFriday

// ============================================================================
// VARIABLES PERSISTENTES (Para tracking de semana)
// ============================================================================

var float mondayLow = na
var float mondayHigh = na
var float mondayClose = na
var bool mondayLowFormed = false
var bool tuesdayConfirmed = false
var bool isValidSetup = false

var float weekHigh = na
var float weekLow = na
var int weekStart = na

// ============================================================================
// RESET SEMANAL
// ============================================================================

// Reset al inicio de la semana (lunes)
if isMonday
    // Calcular LOW y HIGH de la semana anterior para contexto
    weekLow := low
    weekHigh := high
    weekStart := bar_index

    // Reset variables
    mondayLow := low
    mondayHigh := high
    mondayClose := close
    mondayLowFormed := true
    tuesdayConfirmed := false
    isValidSetup := false

// Actualizar HIGH semanal (para comparar con lunes)
if isWeekday
    if na(weekLow)
        weekLow := low
    if na(weekHigh)
        weekHigh := high

    weekLow := math.min(weekLow, low)
    weekHigh := math.max(weekHigh, high)

// ============================================================================
// PASO 1: DETECTAR LOTW EL LUNES
// ============================================================================

// El lunes debe formar un LOW extremo (comparado con los últimos 5 días)
var float last5DaysHigh = na
var float last5DaysLow = na

if bar_index >= 5
    last5DaysHigh := highest(high, 5)
    last5DaysLow := lowest(low, 5)
else
    last5DaysHigh := high
    last5DaysLow := low

// Lunes marca LOTW si es el más bajo en últimos 5 días
isMondayLOTW = mondayLowFormed and low == last5DaysLow and isMonday

// ============================================================================
// PASO 2: CONFIRMACIÓN DEL MARTES (Cierre arriba del lunes)
// ============================================================================

if isTuesday and mondayLowFormed
    // Confirma si cierre > apertura del lunes + pequeño margen
    confirmationLevel = mondayClose + (syminfo.mintick * 5)

    if close > confirmationLevel
        tuesdayConfirmed := true

// ============================================================================
// PASO 3: VALIDAR SETUP COMPLETO
// ============================================================================

// Setup válido si:
// - Lunes formó LOTW
// - Martes confirmó (cierre arriba)
// - Aún quedan días para expansión (no es viernes)

if mondayLowFormed and tuesdayConfirmed and not isFriday and not isSaturday and not isSunday
    isValidSetup := true

// ============================================================================
// PASO 4: MONITOREAR HOTW (High of the Week)
// ============================================================================

var float weeklyHIGH = na
var int hotw_day = na
var bool hotw_formed = false

if isMonday
    weeklyHIGH := high
    hotw_formed := false
    hotw_day := na
else if isWeekday
    if high > weeklyHIGH
        weeklyHIGH := high
        hotw_day := dayOfWeek

// Verificar si HOTW está en jueves/viernes (filtro de expansión)
isHOTW_JueVie = hotw_formed and (hotw_day == 5 or hotw_day == 6)

// ============================================================================
// GENERAR SEÑALES Y DIBUJA
// ============================================================================

// Dibujar zona de LOTW lunes
if mondayLowFormed and isValidSetup
    // Línea de LOTW
    line.new(bar_index - 1, mondayLow, bar_index, mondayLow,
        xloc=xloc.bar_index, color=col_sl, width=2, style=line.style_dashed)

    label.new(bar_index, mondayLow, "LOTW",
        yloc=yloc.belowbar, color=col_sl, textcolor=color.white, size=size.small)

// Dibujar zona de confirmación martes
if isTuesday and tuesdayConfirmed and isValidSetup
    confirmLevel = mondayClose + (syminfo.mintick * 5)
    line.new(bar_index - 1, confirmLevel, bar_index, confirmLevel,
        xloc=xloc.bar_index, color=col_entry, width=2, style=line.style_dotted)

    label.new(bar_index, confirmLevel, "✓ CONFIRMED",
        yloc=yloc.abovebar, color=col_entry, textcolor=color.white, size=size.small)

// ============================================================================
// SEÑAL DE ENTRADA
// ============================================================================

// Entrada cuando:
// 1. Setup válido (Lunes LOTW + Martes confirma)
// 2. Precio pullback al LOW del lunes (+-50 pips)
// 3. HOTW probable en jue/vie (se verifica durante la semana)

signalEntry = isValidSetup and
              close >= mondayLow - (var_sl_pips * syminfo.mintick * 10) and
              close <= mondayLow + (var_confirm_pct * syminfo.mintick * 10)

// ============================================================================
// NIVELES DE STOP LOSS Y TAKE PROFIT
// ============================================================================

stopLossPrice = mondayLow - (var_sl_pips * syminfo.mintick * 10)
takeProfitPrice = mondayLow + ((var_sl_pips * var_risk_reward) * syminfo.mintick * 10)

// ============================================================================
// DIBUJAR SETUP EN GRÁFICO
// ============================================================================

// Si el setup es válido, dibujar rectángulo de entrada
if isValidSetup and not na(mondayLow)
    // Rectángulo de zona de entrada
    box.new(bar_index - 3, mondayLow + (var_confirm_pct * syminfo.mintick * 10),
            bar_index + 3, mondayLow - (var_confirm_pct * syminfo.mintick * 10),
            border_color=col_entry, bgcolor=col_setup, border_width=2)

// Dibujar líneas de SL y TP
if signalEntry
    // Stop Loss
    line.new(bar_index - 2, stopLossPrice, bar_index + 20, stopLossPrice,
        xloc=xloc.bar_index, color=col_sl, width=2, style=line.style_solid)

    label.new(bar_index + 15, stopLossPrice, "SL",
        yloc=yloc.price, color=col_sl, textcolor=color.white, size=size.tiny)

    // Take Profit
    line.new(bar_index - 2, takeProfitPrice, bar_index + 20, takeProfitPrice,
        xloc=xloc.bar_index, color=col_tp, width=2, style=line.style_solid)

    label.new(bar_index + 15, takeProfitPrice, "TP",
        yloc=yloc.price, color=col_tp, textcolor=color.white, size=size.tiny)

    // Punto de entrada
    label.new(bar_index, mondayLow, "BUY SETUP",
        yloc=yloc.belowbar, color=color.green, textcolor=color.white, size=size.small,
        style=label.style_label_up)

// ============================================================================
// ALERTAS
// ============================================================================

// Alerta cuando se detecta setup
alertSetup = isValidSetup and tuesdayConfirmed and isTuesday
alertEntry = signalEntry
alertSL = close < stopLossPrice
alertTP = close > takeProfitPrice

alertcondition(alertSetup, title="Setup Monday Reversal", message="Setup detected: LOTW Monday + Tuesday Confirmed")
alertcondition(alertEntry, title="Entry Signal", message="Entry signal activated at {{close}}")
alertcondition(alertSL, title="Stop Loss Hit", message="Stop Loss hit at {{close}}")
alertcondition(alertTP, title="Take Profit Hit", message="Take Profit reached at {{close}}")

// ============================================================================
// INFORMACIÓN EN PANTALLA
// ============================================================================

var table infoTable = na

// Crear tabla si no existe
if na(infoTable)
    infoTable := table.new(position.top_right, 2, 6, border_width=1)

    table.cell(infoTable, 0, 0, "MONDAY REVERSAL", text_color=color.white, bgcolor=color.navy)
    table.cell(infoTable, 1, 0, "STATUS", text_color=color.white, bgcolor=color.navy)

// Actualizar tabla
statusText = "🔴 WAIT"
if mondayLowFormed and not tuesdayConfirmed
    statusText := "🟡 CONFIRMED?"
if isValidSetup and tuesdayConfirmed
    statusText := "🟢 SETUP"
if signalEntry
    statusText := "🟢 ENTRY"

table.cell(infoTable, 0, 1, "Status", text_color=color.white, bgcolor=color.gray)
table.cell(infoTable, 1, 1, statusText, text_color=color.white, bgcolor=color.gray)

table.cell(infoTable, 0, 2, "Monday Low", text_color=color.white, bgcolor=color.gray)
table.cell(infoTable, 1, 2, str.tostring(mondayLow, format.price), text_color=color.white, bgcolor=color.gray)

table.cell(infoTable, 0, 3, "Stop Loss", text_color=color.white, bgcolor=color.gray)
table.cell(infoTable, 1, 3, str.tostring(stopLossPrice, format.price), text_color=color.white, bgcolor=color.gray)

table.cell(infoTable, 0, 4, "Take Profit", text_color=color.white, bgcolor=color.gray)
table.cell(infoTable, 1, 4, str.tostring(takeProfitPrice, format.price), text_color=color.white, bgcolor=color.gray)

table.cell(infoTable, 0, 5, "RR Ratio", text_color=color.white, bgcolor=color.gray)
rr = (takeProfitPrice - mondayLow) / (mondayLow - stopLossPrice)
table.cell(infoTable, 1, 5, str.tostring(rr, format.price), text_color=color.white, bgcolor=color.gray)

// ============================================================================
// PLOTEAR SEÑALES
// ============================================================================

// Plot para confirmación visual
plotshape(signalEntry, title="Entry", location=location.belowbar,
          shape=shape.labelup, size=size.large, color=color.green,
          textcolor=color.white, text="BUY")

plotshape(alertSL, title="StopLoss Hit", location=location.abovebar,
          shape=shape.labeldown, size=size.large, color=color.red,
          textcolor=color.white, text="SL")

plotshape(alertTP, title="Take Profit", location=location.abovebar,
          shape=shape.star, size=size.large, color=color.orange,
          textcolor=color.white, text="TP")
